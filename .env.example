# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash
# Used when GEMINI_MODEL is over quota or unavailable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
BACKBOARD_API_KEY=your_key_here

# Demo login. Set AUTH_SECRET to a long random string so sessions survive restarts, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty, a random secret is generated at startup.
AUTH_SECRET=
STUDENT_DEMO_PASSWORD=umbc-demo
ADVISOR_USERNAME=advisor
ADVISOR_PASSWORD=advisor-demo

# Appointments (stored in a local SQLite file, separate from the dataset).
# ADVISOR_DISPLAY_NAME=Academic Advisor
# APP_DB_PATH=./app_data/app.db
# ADVISING_TIMEZONE=America/New_York

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Optional overrides
# DATA_DIR=./data
# BACKBOARD_BASE_URL=https://app.backboard.io/api
# BACKBOARD_ASSISTANT_PREFIX=hackumbc-advisor
